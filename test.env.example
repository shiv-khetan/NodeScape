# Real-SSH integration tests. Copy to .env.test.local (gitignored) and fill in.
# Use an UNPRIVILEGED account: tests only write inside NODESCAPE_TEST_DIR and never use sudo.
NODESCAPE_TEST_SSH_CONFIG=C:\path\to\ssh\config
NODESCAPE_TEST_HOST=test-user-alias
NODESCAPE_TEST_DIR=/home/test-user/nodescape-test
