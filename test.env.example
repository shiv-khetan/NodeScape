# Real-SSH integration and Windows real-app tests. Copy to .env.test.local at repo root.
# Missing file: four real-host app tests skip; local security tests still run.
# Verify host trust and noninteractive key/agent login first. Use an existing test directory.
# Use an UNPRIVILEGED account: tests only write inside NODESCAPE_TEST_DIR and never use sudo.
NODESCAPE_TEST_SSH_CONFIG=C:\path\to\ssh\config
NODESCAPE_TEST_HOST=test-user-alias
NODESCAPE_TEST_DIR=/home/test-user/nodescape-test
