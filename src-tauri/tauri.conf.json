{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NodeScape",
  "version": "0.1.0",
  "identifier": "dev.nodescape.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "NodeScape", "width": 1440, "height": 960, "minWidth": 800, "minHeight": 600 }
    ],
    "security": { "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "license": "Apache-2.0",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
